// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Conta
// ---------------------------------------------------------------------------

model User {
  id    String @id @default(uuid())
  email String @unique

  /// Nome de exibição, não é único — só o e-mail identifica a conta.
  /// Herdado da coluna `username` do schema antigo (sem migration de
  /// rename); a API expõe esse valor como `nome`.
  username           String
  password           String
  avatar             String?
  bio                String?
  xpTotal            Int      @default(0)
  level              Int      @default(1)
  streakAtual        Int      @default(0)
  streakRecorde      Int      @default(0)
  onboardingCompleto Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  goalId String?
  goal   Goal?   @relation(fields: [goalId], references: [id])

  userBadges     UserBadge[]
  sessions       StudySession[]
  difficulties   UserDifficulty[]
  availabilities UserAvailability[]
  studyCycles    StudyCycle[]
  reviews        ReviewSchedule[]
  questionLogs   QuestionLog[]
  xpEvents       XpEvent[]
  streakShields  StreakShield[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// Catálogo: objetivo, área (peso), matéria (dificuldade), assunto
// Hierarquia: Goal -> GoalWeight -> Area (peso) -> Subject (dificuldade) -> Topic
// ---------------------------------------------------------------------------

model Goal {
  id           String   @id @default(uuid())
  type         GoalType
  nome         String
  curso        String?
  universidade String?
  cargo        String?
  banca        String?
  createdAt    DateTime @default(now())

  weights GoalWeight[]
  users   User[]

  @@map("goals")
}

model GoalWeight {
  id   String @id @default(uuid())
  peso Float

  goalId String
  goal   Goal   @relation(fields: [goalId], references: [id])

  areaId String
  area   Area   @relation(fields: [areaId], references: [id])

  @@unique([goalId, areaId])
  @@map("goal_weights")
}

model Area {
  id   String @id @default(uuid())
  nome String

  goalWeights GoalWeight[]
  subjects    Subject[]

  @@map("areas")
}

model Subject {
  id   String @id @default(uuid())
  nome String

  areaId String
  area   Area   @relation(fields: [areaId], references: [id])

  topics           Topic[]
  userDifficulties UserDifficulty[]
  cycleBlocks      CycleBlock[]
  studySessions    StudySession[]

  @@map("subjects")
}

model Topic {
  id   String @id @default(uuid())
  nome String

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])

  cycleBlocks   CycleBlock[]
  studySessions StudySession[]
  reviews       ReviewSchedule[]
  questionLogs  QuestionLog[]

  @@map("topics")
}

// ---------------------------------------------------------------------------
// Perfil do usuário dentro do catálogo
// ---------------------------------------------------------------------------

model UserDifficulty {
  id String @id @default(uuid())

  /// 0 = não respondido (valor padrão criado por PUT /me/goal, antes de o
  /// usuário avaliar a matéria). 1-5 = escala válida de autoavaliação.
  /// Nunca tratar 0 como nível real — é o sentinel de "onboarding incompleto".
  dificuldade Int

  userId String
  user   User   @relation(fields: [userId], references: [id])

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])

  @@unique([userId, subjectId])
  @@map("user_difficulties")
}

model UserAvailability {
  id        String @id @default(uuid())
  diaSemana Int
  minutos   Int

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, diaSemana])
  @@map("user_availabilities")
}

// ---------------------------------------------------------------------------
// Ciclo de estudos
// ---------------------------------------------------------------------------

model StudyCycle {
  id           String   @id @default(uuid())
  posicaoAtual Int      @default(0)
  ativo        Boolean  @default(true)
  createdAt    DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  blocks CycleBlock[]

  @@map("study_cycles")
}

model CycleBlock {
  id      String      @id @default(uuid())
  ordem   Int
  duracao Int
  status  BlockStatus @default(PENDENTE)

  cycleId String
  cycle   StudyCycle @relation(fields: [cycleId], references: [id])

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])

  topicId String?
  topic   Topic?  @relation(fields: [topicId], references: [id])

  sessions StudySession[]

  @@index([cycleId, ordem])
  @@map("cycle_blocks")
}

// ---------------------------------------------------------------------------
// Sessão cronometrada
// ---------------------------------------------------------------------------

model StudySession {
  id                String        @id @default(uuid())
  type              SessionType
  preset            SessionPreset
  status            SessionStatus @default(RUNNING)
  startedAt         DateTime      @default(now())
  resumedAt         DateTime?
  minutosAcumulados Int           @default(0)
  /// Meta de duração informada na criação (25 para P25_5, 50 para
  /// P50_10, null para LIVRE). Metadado do preset — o XP usa minutos
  /// reais, nunca este valor.
  duracaoAlvoMin    Int?
  finishedAt        DateTime?
  selfRating        SelfRating?
  xpEarned          Int?
  notes             String?
  studiedAt         DateTime?
  createdAt         DateTime      @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])

  topicId String?
  topic   Topic?  @relation(fields: [topicId], references: [id])

  cycleBlockId String?
  cycleBlock   CycleBlock? @relation(fields: [cycleBlockId], references: [id])

  originReviewId String?
  originReview   ReviewSchedule? @relation("SessionOriginReview", fields: [originReviewId], references: [id])

  @@index([userId, status])
  @@index([userId, startedAt])
  @@map("study_sessions")
}

// ---------------------------------------------------------------------------
// Revisão espaçada
// ---------------------------------------------------------------------------

model ReviewSchedule {
  id           String       @id @default(uuid())
  agendadaPara DateTime
  repeticao    Int          @default(1)
  status       ReviewStatus @default(PENDENTE)
  createdAt    DateTime     @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  topicId String
  topic   Topic  @relation(fields: [topicId], references: [id])

  originOfSessions StudySession[] @relation("SessionOriginReview")

  @@index([userId, agendadaPara, status])
  @@map("review_schedules")
}

// ---------------------------------------------------------------------------
// Questões
// ---------------------------------------------------------------------------

model QuestionLog {
  id        String   @id @default(uuid())
  feitas    Int
  acertadas Int
  data      DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  topicId String
  topic   Topic  @relation(fields: [topicId], references: [id])

  @@index([userId, topicId, data])
  @@map("question_logs")
}

// ---------------------------------------------------------------------------
// Gamificação
// ---------------------------------------------------------------------------

model XpEvent {
  id         String   @id @default(uuid())
  quantidade Int
  motivo     String
  createdAt  DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@map("xp_events")
}

model StreakShield {
  id        String    @id @default(uuid())
  mes       Int
  ano       Int
  usado     Boolean   @default(false)
  usadoEm   DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, mes, ano])
  @@map("streak_shields")
}

// ---------------------------------------------------------------------------
// Badge / UserBadge — mantidas, sem endpoints nesta fase (fase 2)
// ---------------------------------------------------------------------------

model Badge {
  id               String      @id @default(uuid())
  badgeName        String
  badgeDescription String?
  badgeImage       String?
  rarity           Int
  createdAt        DateTime    @default(now())
  userBadges       UserBadge[]

  @@map("badges")
}

model UserBadge {
  id       String   @id @default(uuid())
  earnedAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  badgeId String
  badge   Badge  @relation(fields: [badgeId], references: [id])

  @@map("user_badges")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum SessionType {
  TEORIA
  QUESTOES
  REVISAO
}

enum SessionStatus {
  RUNNING
  PAUSED
  FINISHED
  ABANDONED
}

enum SessionPreset {
  P25_5
  P50_10
  LIVRE
}

enum SelfRating {
  TRAVEI
  OK
  TRANQUILO
}

enum GoalType {
  ENEM
  CONCURSO
}

enum BlockStatus {
  PENDENTE
  CONCLUIDO
}

enum ReviewStatus {
  PENDENTE
  CONCLUIDA
  ARQUIVADA
}
